# Read by both IntraSelf-Web.jsx and IntraSelf-Web-Release.jsx at build time.
# Local dev falls back to http://localhost:3001/api if this isn't set; the
# release build falls back to https://api.intraself.net/api. Setting it
# explicitly here (or in Vercel's Environment Variables) overrides either default.
VITE_BACKEND_URL=http://localhost:3001/api
